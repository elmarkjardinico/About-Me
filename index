<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,400;9..144,500;9..144,600&family=Inter:wght@400;500;600&display=swap" rel="stylesheet">
<style>
  :root{
    --bg:#F5F6F3;
    --surface:#FFFFFF;
    --border:#E2E4DE;
    --border-strong:#CBCFC6;
    --ink:#191C1A;
    --ink-soft:#3E433E;
    --muted:#666B62;
    --accent:#1F4B43;
    --accent-soft:#E7EEE9;
    --gold:#A97A34;
    --serif:'Fraunces', Georgia, 'Times New Roman', serif;
    --sans:'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
    --maxw:1040px;
  }

  *{box-sizing:border-box;}
  html{scroll-behavior:smooth;}
  body{
    margin:0;
    background:var(--bg);
    color:var(--ink);
    font-family:var(--sans);
    font-size:16px;
    line-height:1.65;
    -webkit-font-smoothing:antialiased;
  }
  img,svg{display:block;max-width:100%;}
  a{color:inherit;}
  .wrap{max-width:var(--maxw);margin:0 auto;padding:0 32px;}

  /* -------- Nav -------- */
  header.site-nav{
    position:sticky;top:0;z-index:50;
    background:rgba(245,246,243,0.92);
    backdrop-filter:saturate(140%) blur(8px);
    border-bottom:1px solid var(--border);
  }
  .nav-inner{
    max-width:var(--maxw);margin:0 auto;padding:0 32px;
    display:flex;align-items:center;justify-content:space-between;
    height:68px;
  }
  .brand{
    display:flex;align-items:center;gap:10px;
    font-family:var(--serif);font-weight:600;font-size:19px;letter-spacing:0.2px;
    text-decoration:none;color:var(--ink);
  }
  .brand .mono{
    width:34px;height:34px;border-radius:50%;
    background:var(--accent);color:#fff;
    display:flex;align-items:center;justify-content:center;
    font-family:var(--serif);font-weight:600;font-size:14px;
    flex:none;
    overflow:hidden;
  }
  .brand .mono img{width:100%;height:100%;object-fit:cover;}
  nav.links{display:flex;gap:30px;}
  nav.links a{
    font-size:14.5px;color:var(--ink-soft);text-decoration:none;
    padding:6px 0;margin-right:30px;border-bottom:1px solid transparent;
    transition:color .15s ease, border-color .15s ease;
  }
  nav.links a:last-child{margin-right:0;}
  nav.links a:hover{color:var(--accent);border-color:var(--accent);}
  .nav-cta{
    font-size:14px;font-weight:500;color:#fff;background:var(--ink);
    padding:9px 18px;border-radius:6px;text-decoration:none;
    transition:background .15s ease;
    flex:none;
  }
  .nav-cta:hover{background:var(--accent);}
  .menu-btn{display:none;background:none;border:1px solid var(--border-strong);border-radius:6px;width:40px;height:40px;align-items:center;justify-content:center;cursor:pointer;}
  .menu-btn span, .menu-btn::before, .menu-btn::after{display:none;}
  .menu-btn svg{width:18px;height:18px;stroke:var(--ink);}
  .mobile-panel{display:none;flex-direction:column;gap:2px;padding:12px 32px 20px;border-bottom:1px solid var(--border);background:var(--bg);}
  .mobile-panel a{padding:12px 4px;font-size:15px;text-decoration:none;color:var(--ink-soft);border-bottom:1px solid var(--border);}
  .mobile-panel a:last-child{border-bottom:none;}
  .mobile-panel.open{display:flex;}

  /* -------- Hero -------- */
  .hero{padding:96px 0 80px;}
  .hero-grid{display:grid;grid-template-columns:1.5fr 1fr;gap:56px;align-items:start;}
  .hero-photo{
    width:100%;max-width:280px;aspect-ratio:1/1;border-radius:14px;overflow:hidden;
    border:1px solid var(--border);justify-self:end;margin-top:4px;
  }
  .hero-photo img{width:100%;height:100%;object-fit:cover;display:block;}
  .hero .eyebrow{
    font-size:14.5px;color:var(--accent);font-weight:500;margin:0 0 18px;
  }
  .hero h1{
    font-family:var(--serif);
    font-weight:500;
    font-size:clamp(36px,5.4vw,58px);
    line-height:1.08;
    margin:0 0 22px;
    max-width:14ch;
    color:var(--ink);
  }
  .hero .lede{
    font-size:18px;color:var(--ink-soft);max-width:640px;margin:0 0 36px;
  }
  .hero .cta-row{display:flex;gap:14px;flex-wrap:wrap;}
  .btn{
    display:inline-flex;align-items:center;gap:8px;
    font-size:15px;font-weight:500;text-decoration:none;
    padding:13px 24px;border-radius:6px;
    transition:transform .12s ease, background .15s ease, border-color .15s ease;
  }
  .btn-primary{background:var(--accent);color:#fff;}
  .btn-primary:hover{background:#173a34;}
  .btn-ghost{background:transparent;color:var(--ink);border:1px solid var(--border-strong);}
  .btn-ghost:hover{border-color:var(--accent);color:var(--accent);}

  .hero-meta{
    margin-top:64px;
    display:grid;grid-template-columns:repeat(3,1fr);
    border-top:1px solid var(--border);
    padding-top:28px;
    gap:24px;
  }
  .hero-meta div p:first-child{font-size:13px;color:var(--muted);margin:0 0 6px;}
  .hero-meta div p:last-child{font-size:15.5px;color:var(--ink);margin:0;font-weight:500;}

  /* -------- Section shell -------- */
  section{padding:76px 0;border-top:1px solid var(--border);}
  section:first-of-type{border-top:none;}
  .section-head{margin-bottom:44px;max-width:640px;}
  .section-head .tag{font-size:14px;color:var(--accent);font-weight:500;margin:0 0 10px;}
  .section-head h2{
    font-family:var(--serif);font-weight:500;font-size:clamp(26px,3vw,34px);
    margin:0 0 14px;color:var(--ink);
  }
  .section-head p{color:var(--ink-soft);margin:0;font-size:16px;}

  /* -------- About -------- */
  .about-grid{display:grid;grid-template-columns:1fr 1fr;gap:56px;align-items:start;}
  .about-grid p{color:var(--ink-soft);font-size:16.5px;margin:0 0 18px;}
  .about-grid p:last-child{margin-bottom:0;}
  .about-facts{display:flex;flex-direction:column;gap:22px;}
  .fact{border-left:2px solid var(--accent);padding-left:18px;}
  .fact p:first-child{font-size:13.5px;color:var(--muted);margin:0 0 4px;}
  .fact p:last-child{font-size:16px;color:var(--ink);margin:0;font-weight:500;}

  /* -------- Experience timeline -------- */
  .timeline{position:relative;}
  .tl-item{
    display:grid;grid-template-columns:150px 1fr;gap:32px;
    padding:32px 0;border-top:1px solid var(--border);
  }
  .tl-item:first-child{border-top:none;padding-top:0;}
  .tl-dates{font-size:14.5px;color:var(--muted);padding-top:4px;}
  .tl-role h3{font-family:var(--serif);font-weight:600;font-size:21px;margin:0 0 4px;color:var(--ink);}
  .tl-role .company{font-size:15px;color:var(--accent);margin:0 0 16px;font-weight:500;}
  .tl-role ul{margin:0;padding:0;list-style:none;}
  .tl-role li{
    position:relative;padding-left:20px;margin-bottom:10px;
    color:var(--ink-soft);font-size:15.5px;
  }
  .tl-role li:last-child{margin-bottom:0;}
  .tl-role li::before{
    content:"";position:absolute;left:0;top:9px;
    width:6px;height:6px;border-radius:50%;background:var(--gold);
  }

  /* -------- Skills -------- */
  .skills-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(220px,1fr));gap:28px;}
  .skill-group{background:var(--surface);border:1px solid var(--border);border-radius:10px;padding:26px;}
  .skill-group h3{font-size:15px;margin:0 0 16px;color:var(--accent);font-weight:600;}
  .skill-group ul{margin:0;padding:0;list-style:none;}
  .skill-group li{
    font-size:15px;color:var(--ink-soft);padding:9px 0;border-top:1px solid var(--border);
  }
  .skill-group li:first-child{border-top:none;padding-top:0;}

  /* -------- Education -------- */
  .edu-card{
    background:var(--surface);border:1px solid var(--border);border-radius:10px;
    padding:32px;display:flex;justify-content:space-between;align-items:flex-start;gap:24px;flex-wrap:wrap;
  }
  .edu-card h3{font-family:var(--serif);font-weight:600;font-size:20px;margin:0 0 6px;}
  .edu-card p{margin:0;color:var(--ink-soft);font-size:15.5px;}
  .edu-dates{font-size:14.5px;color:var(--muted);white-space:nowrap;}
  .lang-row{margin-top:22px;display:flex;gap:12px;flex-wrap:wrap;}
  .lang-pill{
    font-size:14px;color:var(--ink);background:var(--accent-soft);
    border:1px solid var(--border);padding:7px 16px;border-radius:20px;
  }

  /* -------- Services -------- */
  .services-list{display:flex;flex-direction:column;}
  .service-row{
    display:grid;grid-template-columns:260px 1fr;gap:32px;
    padding:26px 0;border-top:1px solid var(--border);
  }
  .service-row:first-child{border-top:none;padding-top:0;}
  .service-row h3{font-family:var(--serif);font-weight:600;font-size:19px;margin:0;color:var(--ink);}
  .service-row p{margin:0;color:var(--ink-soft);font-size:15.5px;}

  /* -------- Contact -------- */
  .contact-section{background:var(--ink);color:#EDEEEA;border-top:none;}
  .contact-section .section-head h2{color:#fff;}
  .contact-section .section-head p{color:#C7CAC3;}
  .contact-grid{display:grid;grid-template-columns:1fr 1fr;gap:40px;}
  .contact-list{display:flex;flex-direction:column;gap:20px;}
  .contact-list a, .contact-list span{
    display:flex;align-items:center;gap:14px;
    font-size:16px;text-decoration:none;color:#EDEEEA;
  }
  .contact-list .ic{
    width:38px;height:38px;border-radius:50%;background:rgba(255,255,255,0.08);
    display:flex;align-items:center;justify-content:center;flex:none;
  }
  .contact-list .ic svg{width:17px;height:17px;stroke:#EDEEEA;}
  .contact-note{
    border:1px solid rgba(255,255,255,0.15);border-radius:10px;padding:26px;
    font-size:14.5px;color:#C7CAC3;height:fit-content;
  }
  .contact-note strong{color:#fff;display:block;margin-bottom:8px;font-size:15px;}

  footer{padding:28px 0;border-top:1px solid var(--border);}
  footer .wrap{display:flex;justify-content:space-between;align-items:center;flex-wrap:wrap;gap:10px;}
  footer p{margin:0;font-size:13.5px;color:var(--muted);}

  @media (max-width:860px){
    nav.links, .nav-cta{display:none;}
    .menu-btn{display:flex;}
    .hero-grid{grid-template-columns:1fr;gap:32px;}
    .hero-photo{justify-self:start;max-width:200px;order:-1;}
    .about-grid{grid-template-columns:1fr;gap:36px;}
    .skills-grid{grid-template-columns:1fr;}
    .hero-meta{grid-template-columns:1fr;gap:18px;}
    .service-row, .tl-item{grid-template-columns:1fr;gap:10px;}
    .tl-dates{padding-top:0;}
    .contact-grid{grid-template-columns:1fr;}
    .edu-card{flex-direction:column;}
  }
  @media (max-width:560px){
    .wrap, .nav-inner{padding:0 20px;}
    .hero{padding:56px 0 56px;}
    section{padding:56px 0;}
  }
</style>
</head>
